{
  "expo": {
    "name": "Ilmchi",
    "slug": "ilmchi",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#142452"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.smartteacherbook.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#142452"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.541312544893-favcmb2v7c257r2n7mlslu0e37dilrm1"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "googleWebClientId": "541312544893-favcmb2v7c257r2n7mlslu0e37dilrm1.apps.googleusercontent.com",
      "googleAndroidClientId": "541312544893-favcmb2v7c257r2n7mlslu0e37dilrm1.apps.googleusercontent.com",
      "eas": {
        "projectId": "7ef64ba4-8548-4079-910c-70136530eaed"
      }
    },
    "owner": "khasimovrs-team"
  }
}
