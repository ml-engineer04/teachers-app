# ==============================================================================
# SMARTTEACHERBOOK - MONOREPO ENVIRONMENT TEMPLATE
# ==============================================================================

# -----------------
# API CONFIGURATION
# -----------------
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
ADMIN_PANEL_URL=http://localhost:5173

# -----------------
# DATABASE (PostgreSQL)
# -----------------
DATABASE_URL=postgresql://stb_admin:stb_secret_pass@localhost:5432/smartteacherbook?schema=public
POSTGRES_USER=stb_admin
POSTGRES_PASSWORD=stb_secret_pass
POSTGRES_DB=smartteacherbook
POSTGRES_PORT=5432

# -----------------
# REDIS (Rate limiting / Queues)
# -----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------
# JWT & SECURITY
# -----------------
JWT_ACCESS_SECRET=stb_jwt_super_access_secret_key_change_in_production_min32chars
JWT_REFRESH_SECRET=stb_jwt_super_refresh_secret_key_change_in_production_min32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=90d

# -----------------
# ASYMMETRIC LICENSE SIGNING (RS256 or Ed25519)
# -----------------
# Private key used by NestJS to sign offline license tokens for mobile devices
LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6...\n-----END PRIVATE KEY-----"
# Public key embedded in Mobile App & verified in backend tests
LICENSE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"

# -----------------
# AWS S3 (Book Bundles, Media, Encrypted Packages)
# -----------------
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test_aws_key_id
AWS_SECRET_ACCESS_KEY=test_aws_secret_key
AWS_S3_BUCKET_NAME=smartteacherbook-content-storage
# For local minio development (leave empty for real AWS S3)
AWS_S3_ENDPOINT=

# -----------------
# AWS SES (Transactional Email & Admin Alerts)
# -----------------
SES_REGION=eu-central-1
SES_FROM_EMAIL=no-reply@smartteacherbook.com
SES_SUPPORT_EMAIL=support@smartteacherbook.com
ADMIN_ALERT_EMAILS=superadmin@smartteacherbook.com,ops@smartteacherbook.com

# -----------------
# BUSINESS DEFAULTS
# -----------------
DEFAULT_SUBSCRIPTION_DAYS=30
MAX_DEVICES_PER_USER=2
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
PIN_LOCKOUT_ATTEMPTS=5

# -----------------
# MOBILE CLIENT CONFIG
# -----------------
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_APP_ENV=development

# -----------------
# GOOGLE OAUTH 2.0 (Google Sign-In)
# -----------------
# Web OAuth Client ID created in Google Cloud Console (used by NestJS backend to verify token audience, and mobile as webClientId)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Android OAuth Client ID created in Google Cloud Console (bound to package com.smartteacherbook.app and SHA-1 fingerprint)
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
