{
  "name": "smartteacherbook-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ilmçi (ilmchi.uz) - O‘qituvchilar va maktablar uchun raqamli darsliklar platformasi",
  "scripts": {
    "build:shared": "pnpm --filter @smartteacherbook/shared build",
    "dev:api": "pnpm --filter @smartteacherbook/api start:dev",
    "dev:admin": "pnpm --filter @smartteacherbook/admin dev",
    "dev:web": "pnpm --filter @smartteacherbook/web dev",
    "dev:mobile": "pnpm --filter @smartteacherbook/mobile start",
    "build:all": "pnpm -r build",
    "test:security": "./apps/api/node_modules/.bin/ts-node --project apps/api/tsconfig.json tests/run-all-tests.ts",
    "test": "pnpm run test:security",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "canvas",
      "esbuild",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "canvas"
    ]
  },
  "devDependencies": {
    "@babel/runtime": "^8.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@12.16.1"
}
